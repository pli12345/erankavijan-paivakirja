{
  "expo": {
    "name": "Eränkävijän päiväkirja",
    "slug": "metsastajan-paivakirja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "erankavijanpaivakirja",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fi.erankavija.paivakirja",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sijaintia käytetään reissujen, saaliiden ja havaintojen paikan tallentamiseen sekä sään hakemiseen.",
        "NSCameraUsageDescription": "Kameraa käytetään saaliskuvien ottamiseen.",
        "NSPhotoLibraryUsageDescription": "Kuvakirjastoa käytetään saaliskuvien valitsemiseen."
      }
    },
    "android": {
      "package": "fi.erankavija.paivakirja",
      "adaptiveIcon": {
        "backgroundColor": "#1F3D2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4EF",
          "dark": {
            "backgroundColor": "#101410"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sijaintia käytetään reissujen, saaliiden ja havaintojen paikan tallentamiseen sekä sään hakemiseen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kuvakirjastoa käytetään saaliskuvien valitsemiseen.",
          "cameraPermission": "Kameraa käytetään saaliskuvien ottamiseen."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
